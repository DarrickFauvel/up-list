<%
  const initSignals = JSON.stringify({
    generating:      false,
    error:           '',
    imageBase64:     '',
    imageMimeType:   'image/jpeg',
    title:           it.item.title ?? '',
    description:     it.item.description ?? '',
    category_id:     String(it.item.category_id ?? ''),
    category_name:   it.item.category_name ?? '',
    condition:       it.item.condition ?? '',
    suggested_price: it.item.suggested_price != null ? String(it.item.suggested_price) : '',
    final_price:     it.item.final_price != null ? String(it.item.final_price) : '',
    notes:           it.item.notes ?? '',
    category_suggestions: [],
    sku:             it.item.sku ?? '',
    location:        it.item.location ?? '',
    cost:            it.item.cost != null ? String(it.item.cost) : '',
    shipping_weight: it.item.shipping_weight != null ? String(it.item.shipping_weight) : '',
    shipping_length: it.item.shipping_length != null ? String(it.item.shipping_length) : '',
    shipping_width:  it.item.shipping_width  != null ? String(it.item.shipping_width)  : '',
    shipping_height: it.item.shipping_height != null ? String(it.item.shipping_height) : '',
    ai_status: '',
  });
%>
<script>
  // Plain (non-module) script — runs synchronously during parsing, so this is
  // guaranteed to exist before Datastar's own deferred initial scan runs any
  // data-effect/data-init that calls it. A module script here would NOT be
  // safe: module scripts are deferred like Datastar's own bootstrap, and the
  // two can execute in either order, causing "window.computeSku is not a
  // function" to be thrown from data-effect during Datastar's initial scan —
  // which then silently aborts processing of data-init on the same element.
  window.computeSku = (location, cost) => {
    if (!location || cost === '' || cost == null || Number.isNaN(Number(cost))) return '';
    const cents = String(Math.round(Number(cost) * 100)).padStart(3, '0');
    const now  = new Date();
    const pad  = n => String(n).padStart(2, '0');
    const date = `${String(now.getFullYear()).slice(2)}${pad(now.getMonth() + 1)}${pad(now.getDate())}`;
    const time = `${pad(now.getHours())}${pad(now.getMinutes())}`;
    return `${location}-${cents}-${date}-${time}`;
  };
</script>
<div class="page-wrap" data-signals="<%= initSignals %>"
  data-effect="document.title = ($title || 'Draft') + ' — UpList'; $sku = window.computeSku($location, $cost)"
  data-init="if (!$title) { @post('/items/<%= it.item.id %>/generate') }">

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumb-link">Dashboard</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <span class="breadcrumb-current" data-text="$title || 'Draft'"><%= it.item.title || 'Draft' %></span>
  </nav>

  <div class="page-header">
    <h1 id="page-title" data-text="$title || 'Draft'"><%= it.item.title ?? 'Draft' %></h1>
    <span class="status-badge status-<%= it.item.status %>" id="status-badge"><%= it.item.status %></span>
  </div>

  <div class="edit-layout">

    <!-- ── Sidebar ───────────────────────────────────────── -->
    <aside class="edit-sidebar">

      <!-- Multi-photo grid (max 20 photos) -->
      <div class="photo-manager" id="photo-manager">
        <div class="photo-grid" id="photo-grid">
          <!-- Thumbnails injected by JS -->
          <button type="button" class="photo-add-btn" id="photo-camera-btn" aria-label="Take photo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>
            </svg>
            Take photo
          </button>
          <button type="button" class="photo-add-btn" id="photo-add-btn" aria-label="Add photo from library">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add photo
          </button>
        </div>
        <input type="file" accept="image/*" id="photo-file-input" style="display:none" multiple>
      </div>

      <up-camera-session id="camera-session"></up-camera-session>

      <!-- Hidden signal inputs so Datastar carries primary photo to generate -->
      <input type="text" id="sig-imageBase64" data-bind:imageBase64 style="display:none" aria-hidden="true" tabindex="-1">
      <input type="text" id="sig-imageMimeType" data-bind:imageMimeType style="display:none" aria-hidden="true" tabindex="-1">
      <input type="text" id="sig-category-name" data-bind:category_name style="display:none" aria-hidden="true" tabindex="-1">

      <div class="field" style="margin-top:1rem">
        <label for="notes">Notes</label>
        <textarea id="notes" rows="2" placeholder="Extra details for the AI…" data-bind:notes><%= it.item.notes ?? '' %></textarea>
      </div>

      <div class="field">
        <div class="field-label-row">
          <label for="f-condition">Condition</label>
          <button type="button" class="field-info-btn" aria-label="What do these conditions mean?"
            data-on:click="document.getElementById('condition-info-modal').open()">i</button>
        </div>
        <select id="f-condition" name="condition"
          data-bind:condition
          data-attr:data-streaming="$generating ? 'true' : 'false'">
          <option value="">— select —</option>
          <% for (const opt of [['NEW','New'],['LIKE_NEW','Like New'],['USED_GOOD','Used – Good'],['USED_FAIR','Used – Fair'],['FOR_PARTS','For Parts']]) { %>
          <option value="<%= opt[0] %>"><%= opt[1] %></option>
          <% } %>
        </select>
        <p class="field-hint">Pick the condition first — the AI uses it to write an accurate title, description, and price.</p>
      </div>

      <up-modal id="condition-info-modal">
        <div class="um-title">Item condition guide</div>
        <p class="um-body">eBay's standard definitions for each condition, so your listing sets the right expectations.</p>
        <dl class="condition-guide">
          <dt>New</dt>
          <dd>A brand-new, unused, unopened, undamaged item in its original packaging (where packaging is applicable). Packaging should be the same as what is found in a retail store, unless the item was packaged by the manufacturer in non-retail packaging.</dd>

          <dt>Like New</dt>
          <dd>An item in excellent, new condition with no signs of wear or use. The original packaging may be missing or opened, and original accessories may be incomplete, but the item itself is like-new.</dd>

          <dt>Used – Good</dt>
          <dd>An item that has been used previously. May have minor cosmetic wear but is fully operational and functions as intended.</dd>

          <dt>Used – Fair</dt>
          <dd>An item with visible wear from consistent use, but still fully functional. May have noticeable scratches, dents, or blemishes, and could be missing minor non-essential parts.</dd>

          <dt>For Parts</dt>
          <dd>An item that does not function as intended and is not fully operational. Being sold for parts or repair, and may have cosmetic and/or functional defects.</dd>
        </dl>
        <div class="um-actions">
          <button class="btn btn-primary btn-full" data-action="close">Got it</button>
        </div>
      </up-modal>

      <button type="button" id="generate-btn" class="btn btn-outline btn-full"
        data-attr:disabled="$generating"
        data-on:click="@post('/items/<%= it.item.id %>/generate')">
        <span data-show="!$generating">✦ Generate with AI</span>
        <span data-show="$generating" style="display:none" data-text="$ai_status || 'Generating…'"></span>
      </button>

      <p class="field-hint" data-show="!$condition" <%~ it.item.condition ? 'style="display:none"' : '' %>>Optional: pick a condition to lock it in, or leave it blank and AI will suggest one.</p>

      <p class="error-msg" data-show="$error" data-text="$error" style="display:none"></p>

    </aside>

    <!-- ── Main fields ───────────────────────────────────── -->
    <section class="edit-main">

      <div class="field">
        <label for="f-title">Title</label>
        <div class="field-input-wrap field-input-wrap--input">
          <input type="text" id="f-title" name="title" maxlength="80"
            data-bind:title
            data-attr:data-streaming="$generating ? 'true' : 'false'">
          <button type="button" class="field-copy-btn" aria-label="Copy title to clipboard"
            data-copy-target="f-title" data-copy-label="Title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
        <p class="field-hint">Pattern: Brand + Product Type + Attributes (Size, Color, Material) + Condition</p>
      </div>

      <div class="field">
        <label for="f-description">Description</label>
        <div class="field-input-wrap field-input-wrap--textarea">
          <textarea id="f-description" name="description" rows="6"
            data-bind:description
            data-attr:data-streaming="$generating ? 'true' : 'false'"></textarea>
          <button type="button" class="field-copy-btn" aria-label="Copy description to clipboard"
            data-copy-target="f-description" data-copy-label="Description">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="field">
        <label for="f-category">Category</label>
        <div class="category-row">
          <p class="category-name-display" data-attr:data-empty="!$category_name ? 'true' : 'false'"
            data-text="$category_name || 'Not set yet — generate or enter an ID above'"><%= it.item.category_name || 'Not set yet — generate or enter an ID above' %></p>
          <div class="cat-id-pill">
            <span class="cat-id-pill-label">cat_id:</span>
            <input type="text" id="f-category" name="category_id" placeholder="—"
              class="cat-id-pill-input"
              data-bind:category_id
              data-attr:data-streaming="$generating ? 'true' : 'false'"
              data-on:input="$category_name = ''">
          </div>
        </div>
        <div class="category-suggestions" data-show="$category_suggestions.length > 0" style="display:none">
          <span class="category-suggestions-label">Also consider:</span>
          <button type="button" class="category-suggestion-chip" data-show="$category_suggestions[0]" style="display:none"
            data-text="$category_suggestions[0]?.name"
            data-on:click="$category_id = $category_suggestions[0].id; $category_name = $category_suggestions[0].name"></button>
          <button type="button" class="category-suggestion-chip" data-show="$category_suggestions[1]" style="display:none"
            data-text="$category_suggestions[1]?.name"
            data-on:click="$category_id = $category_suggestions[1].id; $category_name = $category_suggestions[1].name"></button>
          <button type="button" class="category-suggestion-chip" data-show="$category_suggestions[2]" style="display:none"
            data-text="$category_suggestions[2]?.name"
            data-on:click="$category_id = $category_suggestions[2].id; $category_name = $category_suggestions[2].name"></button>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-suggested">AI suggested price (USD)</label>
          <input type="number" id="f-suggested" name="suggested_price" step="0.01" min="0"
            data-bind:suggested_price
            placeholder="—" readonly>
        </div>
        <div class="field">
          <label for="f-price">Your price (USD)</label>
          <input type="number" id="f-price" name="final_price" step="0.01" min="0"
            data-bind:final_price
            placeholder="0.00">
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-location">Bin / Location</label>
          <input type="text" id="f-location" name="location" placeholder="e.g. BS1"
            data-bind:location>
        </div>
        <div class="field">
          <label for="f-cost">Your cost (USD)</label>
          <input type="number" id="f-cost" name="cost" step="0.01" min="0"
            data-bind:cost
            placeholder="0.00">
        </div>
      </div>

      <div class="field">
        <label for="f-sku">SKU</label>
        <input type="text" id="f-sku" name="sku"
          data-bind:sku
          placeholder="Set location + cost to generate" readonly>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-weight">Shipping weight (lb)</label>
          <input type="number" id="f-weight" name="shipping_weight" step="0.01" min="0"
            data-bind:shipping_weight
            placeholder="0.00">
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-length">Length (in)</label>
          <input type="number" id="f-length" name="shipping_length" step="0.1" min="0"
            data-bind:shipping_length
            placeholder="0.0">
        </div>
        <div class="field">
          <label for="f-width">Width (in)</label>
          <input type="number" id="f-width" name="shipping_width" step="0.1" min="0"
            data-bind:shipping_width
            placeholder="0.0">
        </div>
        <div class="field">
          <label for="f-height">Height (in)</label>
          <input type="number" id="f-height" name="shipping_height" step="0.1" min="0"
            data-bind:shipping_height
            placeholder="0.0">
        </div>
      </div>

      <div class="action-row">
        <button type="button" class="btn btn-ghost" id="save-btn">Save draft</button>
        <up-publish-btn item-id="<%= it.item.id %>"></up-publish-btn>
        <button type="button" class="btn btn-ghost btn-danger" id="delete-btn">Delete</button>
      </div>

    </section>

  </div>
</div>

<script type="module">
  import { createPhotoManager } from '/js/photo-manager.js';
  import { dataUrlToParts } from '/js/image-utils.js';

  const ITEM_ID    = '<%= it.item.id %>';
  const MAX_PHOTOS = 20;

  // ── Auto-extract location/cost from notes on page load ───
  // Deterministic (no AI call needed) so it works immediately, even before a
  // condition is picked and "Generate with AI" becomes available. Only runs
  // when both fields are still empty, so it never clobbers a value the
  // seller already entered or previously saved.
  (function autoExtractFromNotes() {
    const locationInput = document.getElementById('f-location');
    const costInput     = document.getElementById('f-cost');
    const notesInput    = document.getElementById('notes');
    if (!locationInput || !costInput || !notesInput) return;
    if (locationInput.value || costInput.value) return;

    const notes = notesInput.value;
    if (!notes) return;

    const costMatch = notes.match(/\b(?:cost|paid)\b\s*:?\s*\$?\s*(\d+(?:\.\d{1,2})?)/i);
    if (costMatch) {
      costInput.value = costMatch[1];
      costInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    const locationMatch = notes.match(/\b(?:location|loc|bin)\b\s*:?\s*([A-Za-z0-9][A-Za-z0-9-]{0,9})/i);
    if (locationMatch) {
      locationInput.value = locationMatch[1];
      locationInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
  })();

  // ── Photo manager ────────────────────────────────────────
  // Load existing photos from DB (images column = JSON array, or fall back to image_url)
  let initImages = [];
  try {
    const raw = <%~ JSON.stringify(it.item.images ?? null) %>;
    if (raw) {
      initImages = JSON.parse(raw);
    } else {
      const img = <%~ JSON.stringify(it.item.image_url ?? null) %>;
      if (img) initImages = [img];
    }
  } catch (e) {}

  // photos = [{ dataUrl, base64, mimeType }, ...]
  const initialPhotos = initImages.map(dataUrl => ({ dataUrl, ...dataUrlToParts(dataUrl) }));

  function updatePrimarySignal(photos) {
    const b64Input  = document.getElementById('sig-imageBase64');
    const mimeInput = document.getElementById('sig-imageMimeType');
    const primary   = photos[0];
    if (b64Input) {
      b64Input.value = primary?.base64 ?? '';
      b64Input.dispatchEvent(new Event('input', { bubbles: true }));
    }
    if (mimeInput) {
      mimeInput.value = primary?.mimeType ?? 'image/jpeg';
      mimeInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  const photoManager = createPhotoManager({
    gridEl:        document.getElementById('photo-grid'),
    cameraBtn:     document.getElementById('photo-camera-btn'),
    addBtn:        document.getElementById('photo-add-btn'),
    fileInput:     document.getElementById('photo-file-input'),
    cameraSession: document.getElementById('camera-session'),
    maxPhotos:     MAX_PHOTOS,
    initialPhotos,
    showPrimaryLabel: true,
    onChange: updatePrimarySignal,
  });

  // ── Copy to clipboard ────────────────────────────────────
  async function copyField(targetId, label) {
    const field = document.getElementById(targetId);
    const value = (field?.value ?? '').trim();

    if (!value) {
      document.querySelector('up-toast')?.show(`Nothing to copy — ${label} is empty`, 'info');
      return;
    }

    try {
      await navigator.clipboard.writeText(field.value);
      document.querySelector('up-toast')?.show(`${label} copied to clipboard`, 'success');
    } catch (err) {
      document.querySelector('up-toast')?.show('Could not copy — clipboard access was denied', 'error');
    }
  }

  document.querySelectorAll('[data-copy-target]').forEach(btn => {
    btn.addEventListener('click', () => copyField(btn.dataset.copyTarget, btn.dataset.copyLabel));
  });

  // ── Save draft ──────────────────────────────────────────
  document.getElementById('save-btn').addEventListener('click', async () => {
    const saveBtn = document.getElementById('save-btn');
    saveBtn.disabled = true;

    await fetch(`/items/${ITEM_ID}`, {
      method:  'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title:         document.getElementById('f-title').value,
        description:   document.getElementById('f-description').value,
        category_id:   document.getElementById('f-category').value,
        category_name: document.getElementById('sig-category-name').value,
        condition:     document.getElementById('f-condition').value,
        final_price:   document.getElementById('f-price').value,
        image_url:     photoManager.getPhotos()[0]?.dataUrl ?? null,
        images:        JSON.stringify(photoManager.getPhotos().map(p => p.dataUrl)),
        notes:         document.getElementById('notes').value,
        sku:             document.getElementById('f-sku').value,
        location:        document.getElementById('f-location').value,
        cost:            document.getElementById('f-cost').value,
        shipping_weight: document.getElementById('f-weight').value,
        shipping_length: document.getElementById('f-length').value,
        shipping_width:  document.getElementById('f-width').value,
        shipping_height: document.getElementById('f-height').value,
      }),
    });

    window.location.href = '/dashboard';
  });

  // ── Delete draft ────────────────────────────────────────
  document.getElementById('delete-btn').addEventListener('click', async () => {
    if (!await confirmDelete('This listing will be permanently deleted.')) return;
    await fetch(`/items/${ITEM_ID}`, { method: 'DELETE' });
    window.location.href = '/dashboard';
  });
</script>
