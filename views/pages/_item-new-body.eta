<%
  const draft = it.draft ?? null;
  const initImages = draft?.images ? JSON.parse(draft.images) : (draft?.image_url ? [draft.image_url] : []);
  const initSignals = JSON.stringify({
    notes: draft?.notes ?? '',
    images: JSON.stringify(initImages),
    saving: false,
  });
%>
<div class="page-wrap" data-signals="<%= initSignals %>">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumb-link">Dashboard</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <span class="breadcrumb-current">New listing</span>
  </nav>

  <div class="page-header">
    <h1>New listing</h1>
  </div>

  <form class="new-item-form" id="new-item-form"
    data-on:submit__prevent="$saving = true; window.persistAndContinue()">

    <div class="photo-manager" id="photo-manager">
      <div class="photo-grid" id="photo-grid">
        <button type="button" class="photo-add-btn" id="photo-camera-btn" aria-label="Take photo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>
          </svg>
          Take photo
        </button>
        <button type="button" class="photo-add-btn" id="photo-add-btn" aria-label="Add photo from library">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add photo
        </button>
      </div>
      <input type="file" accept="image/*" id="photo-file-input" style="display:none" multiple>
    </div>

    <up-camera-session id="camera-session"></up-camera-session>
    <input type="text" id="sig-images" data-bind:images style="display:none" aria-hidden="true" tabindex="-1">

    <div class="field">
      <label for="notes">Notes <span class="optional">(optional)</span></label>
      <textarea
        id="notes"
        name="notes"
        rows="3"
        placeholder="Brand, size, condition — anything useful for the AI…"
        data-bind:notes
      ><%= draft?.notes ?? '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-full btn-lg" id="new-item-submit" data-attr:disabled="$saving || $images === '[]'">
      <span data-show="!$saving">Continue →</span>
      <span data-show="$saving" style="display:none">Saving…</span>
    </button>
  </form>

</div>

<script type="module">
  import { createPhotoManager } from '/js/photo-manager.js';
  import { dataUrlToParts } from '/js/image-utils.js';

  const initImages = <%~ JSON.stringify(initImages) %>;
  const initialPhotos = initImages.map(dataUrl => ({ dataUrl, ...dataUrlToParts(dataUrl) }));

  let draftId = <%~ JSON.stringify(draft?.id ?? null) %>;

  function debounce(fn, ms) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
  }

  let saveInFlight  = false;
  let pendingResave = false;

  async function persistDraft() {
    if (saveInFlight) { pendingResave = true; return; }
    const notes  = document.getElementById('notes').value;
    const photos = manager.getPhotos();
    if (!notes.trim() && photos.length === 0) return;

    saveInFlight = true;
    try {
      if (!draftId) {
        const res  = await fetch('/items', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notes, images: JSON.stringify(photos.map(p => p.dataUrl)) }),
        });
        const data = await res.json();
        draftId = data.id;
        history.replaceState(null, '', `/items/new?draft=${draftId}`);
      } else {
        await fetch(`/items/${draftId}`, {
          method:  'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: '', description: '', category_id: '', condition: '', final_price: '',
            image_url: photos[0]?.dataUrl ?? null,
            images:    JSON.stringify(photos.map(p => p.dataUrl)),
            notes,
          }),
        });
      }
    } finally {
      saveInFlight = false;
      if (pendingResave) { pendingResave = false; persistDraft(); }
    }
  }

  const scheduleSave = debounce(persistDraft, 800);

  const manager = createPhotoManager({
    gridEl:        document.getElementById('photo-grid'),
    cameraBtn:     document.getElementById('photo-camera-btn'),
    addBtn:        document.getElementById('photo-add-btn'),
    fileInput:     document.getElementById('photo-file-input'),
    cameraSession: document.getElementById('camera-session'),
    maxPhotos:     20,
    initialPhotos,
    showPrimaryLabel: true,
    sortable:      true,
    onChange: photos => {
      const input = document.getElementById('sig-images');
      input.value = JSON.stringify(photos.map(p => p.dataUrl));
      input.dispatchEvent(new Event('input', { bubbles: true }));
      scheduleSave();
    },
  });

  document.getElementById('notes').addEventListener('input', scheduleSave);

  window.persistAndContinue = async () => {
    await persistDraft();
    if (draftId) window.location.href = `/items/${draftId}`;
  };
</script>
